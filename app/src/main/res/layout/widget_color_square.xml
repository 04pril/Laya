<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS WidgetPod card, by its own measurements (158x158 design units, see PosterWidgetViews): each piece sits at
     the same fraction of the card through layout weights, and ColorMediaWidget pads color_box to that aspect and sets
     the text and glyph sizes for the card's real size. The field is a stretched wash; the cover is its own view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/color_root" android:background="@drawable/widget_color_background" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/color_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
<FrameLayout android:id="@+id/color_box" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="15.5" />
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="67" android:orientation="horizontal">
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="15.5" />
<ImageView android:id="@+id/color_cover" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="67" android:scaleType="fitCenter" android:contentDescription="@null" />
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="75.5" />
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="75.5" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="15.5" />
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="127" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="86" />
<TextView android:id="@+id/color_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="16" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textColor="#ffffff" android:textSize="12.5dp" />
<TextView android:id="@+id/color_artist" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="18" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#e0ffffff" android:textSize="12.5dp" />
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="38" />
</LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="15.5" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="117.5" />
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="36" android:orientation="horizontal">
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="8" />
<ImageButton android:id="@+id/color_previous" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="36" android:scaleType="fitCenter" android:src="@drawable/ic_pod_backward" android:background="@android:color/transparent" android:contentDescription="@string/widget_previous" />
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="17" />
<ImageButton android:id="@+id/color_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="36" android:scaleType="fitCenter" android:src="@drawable/ic_pod_play" android:background="@android:color/transparent" android:contentDescription="@string/play" />
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="17" />
<ImageButton android:id="@+id/color_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="36" android:scaleType="fitCenter" android:src="@drawable/ic_pod_forward" android:background="@android:color/transparent" android:contentDescription="@string/widget_next" />
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="8" />
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="4.5" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="15" />
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="22" android:orientation="horizontal">
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="121" />
<ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="22" android:scaleType="fitCenter" android:src="@drawable/widget_music_glyph" android:tint="#fff5c4" android:contentDescription="@null" />
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="15" />
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="121" />
</LinearLayout>
</FrameLayout>
</FrameLayout>
